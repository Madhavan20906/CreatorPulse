# CreatorPulse Environment Configuration

# Server Port
PORT=3000

# Optional: Google Gemini API Key
# Get a free key at https://aistudio.google.com/
# If omitted, CreatorPulse automatically uses its built-in deterministic strategy engine
# and 128d dense subword vector cosine similarity for 100% offline resilience.
GEMINI_API_KEY=

# Optional: Gemini Model Selection (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: PostgreSQL Database URL
# If omitted, CreatorPulse uses persistent in-memory demo state with zero crashes.
DATABASE_URL=
