{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/creatorpulse run build",
  "outputDirectory": "artifacts/creatorpulse/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}